{
  "name": "p5.svg",
  "version": "0.0.0",
  "description": "Native SVG export and Import for p5.js using Shape system",
  "type": "module",
  "exports": {
    "./export": "./dist/p5.svg-export.min.js"
  },
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "test": "vitest run --project unit-tests",
    "test:visual": "vitest run --project visual-tests",
    "test:visual:update": "vitest run --project visual-tests --update",
    "test:all": "vitest run",
    "report": "node test/visual/report/generate-report.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-webdriverio": "^4.1.8",
    "pixelmatch": "^7.2.0",
    "rollup": "^4.41.1",
    "vitest": "^4.1.8",
    "webdriverio": "^9.0.7",
    "pre-commit": "^2.0.0"
  },
  "pre-commit": [
    "test:all"
  ]
}
